# Server Configuration
PORT=5000

# MongoDB Connection URI
# Local MongoDB default:
MONGODB_URI=mongodb://127.0.0.1:27017/community_skill_exchange

# If using MongoDB Atlas (Cloud), replace with your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/community_skill_exchange?retryWrites=true&w=majority
